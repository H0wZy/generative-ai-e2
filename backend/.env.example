# Operational database (PostgreSQL on port 5432 — Docker or local install)
DATABASE_URL=postgresql://genai_e2:genai_e2_dev@localhost:5432/genai_e2

# Test database (separate database, same PostgreSQL instance)
TEST_DATABASE_URL=postgresql://genai_e2:genai_e2_dev@localhost:5432/genai_e2_test

# PostgreSQL password for docker compose
POSTGRES_PASSWORD=genai_e2_dev

# Jira integration (optional — omit to use FakeJiraClient for local demos)
# JIRA_BASE_URL=https://your-tenant.atlassian.net
# JIRA_EMAIL=your-email@example.com
# JIRA_API_TOKEN=your-jira-api-token

# Jira project keys — one per squad
# JIRA_PROJECT_IDENTITY=IDEN
# JIRA_PROJECT_FINANCE=FIN
# JIRA_PROJECT_PLATFORM=PLAT

# LLM squad classification (optional — only used when deterministic routing
# can't match a category). Ollama runs locally, no API key involved.
# Default false is a measured security decision, not a placeholder: the
# golden set found a 2/2 prompt-injection success rate. Read the "Escopo do
# MVP" section in README.md before flipping this to true.
# LLM_ENABLED=false
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen3:8b
# LLM_CONFIDENCE_THRESHOLD=0.7
# LLM_TIMEOUT_SECONDS=20
